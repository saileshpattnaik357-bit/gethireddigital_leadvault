FRONTEND_URL=http://localhost:3000

# Optional LLM refinement
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Comma-separated Apify tokens. Keep real values only in .env, not in git.
APIFY_API_TOKENS=
APIFY_LINKEDIN_ACTORS=supreme_coder/linkedin-post,harvestapi/linkedin-post-search,get-leads/linkedin-scraper

# Harness: optional LLM second opinion on borderline classifications (off by default)
LEADVAULT_LLM_VALIDATION=0
# Local testing: ollama (no key, no spend). Cloud Run: openai + OPENAI_API_KEY.
LEADVAULT_LLM_PROVIDER=ollama
LEADVAULT_LLM_MODEL=mistral
OLLAMA_BASE_URL=http://localhost:11434/v1
LEADVAULT_LLM_TIMEOUT=60
