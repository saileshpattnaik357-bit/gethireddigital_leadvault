# Cloud Run environment — set these as Cloud Run env vars / Secret Manager, never commit real values.
FRONTEND_URL=https://<your-frontend-domain>
ENVIRONMENT=prod

# Mining sources
APIFY_API_TOKENS=<secret>
APIFY_LINKEDIN_ACTORS=supreme_coder/linkedin-post,harvestapi/linkedin-post-search,get-leads/linkedin-scraper

# Harness LLM validation on OpenAI (cheap model; only borderline rows are sent, capped at 40/run)
LEADVAULT_LLM_VALIDATION=1
LEADVAULT_LLM_PROVIDER=openai
LEADVAULT_LLM_MODEL=gpt-4o-mini
LEADVAULT_LLM_TIMEOUT=20
OPENAI_API_KEY=<secret>
