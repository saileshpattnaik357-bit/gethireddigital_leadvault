{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "leadvault-backend",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "uvicorn", "main:app", "--host", "127.0.0.1", "--port", "8000"],
      "cwd": "backend",
      "port": 8000
    },
    {
      "name": "leadvault-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--", "-H", "127.0.0.1", "-p", "3000"],
      "cwd": "frontend",
      "port": 3000
    }
  ]
}
